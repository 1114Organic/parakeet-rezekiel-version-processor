feeds:
  - name: "The Tim Ferriss Show"
    url: "https://rss.art19.com/tim-ferriss-show"
    category: "productivity"
  
  - name: "a16z Podcast"
    url: "https://feeds.feedburner.com/a16z"
    category: "tech"
    # Optional per-feed overrides:
    # force: true      # re-download existing episodes for this feed
    # dry_run: true    # report what would be downloaded for this feed
    
  - name: "Y Combinator Podcast"
    url: "https://blog.ycombinator.com/feed/"
    category: "startups"

# Per-feed options (optional):
# - `force`: when true will re-download episodes already present in the DB (match by `url`)
# - `dry_run`: when true will only report actions for that feed without downloads or DB writes

# Global settings
settings:
  audio_format: "wav"
  max_episodes_per_feed: 10  # global default; can be overridden per-feed via `max_episodes` key
  cleanup_old_files: true
  cleanup_days: 30
  
  # Transcription
  whisper_model: "base"  # tiny, base, small, medium, large
  parakeet_enabled: true  # Use Parakeet MLX on Apple Silicon
  parakeet_model: "mlx-community/parakeet-tdt-0.6b-v2"
  
  # LLM cleaning
  llm_provider: "ollama"  # openai, anthropic, ollama
  llm_model: "llama3.2"  # For Ollama: llama3.2, qwen2.5, etc.
  ollama_base_url: "http://localhost:11434"
  
  # Output
  export_format: ["markdown", "json"]
  email_enabled: false
